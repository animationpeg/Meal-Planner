@page "/shoppinglist"
@inject ShoppingListService ShoppingListService

<MudText Typo="Typo.h4" Class="mb-4">Shopping List</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_noActivePlan)
{
    <MudText>No active meal plan found. Set a meal plan as active to generate a shopping list.</MudText>
}
else if (_shoppingList is null || !_shoppingList.Items.Any())
{
    <MudText>No ingredients found in the active meal plan.</MudText>
}
else
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        @(_shoppingList.Items.Count(i => i.IsChecked)) of @_shoppingList.Items.Count items checked off
    </MudText>

    <MudDropContainer T="ShoppingListItem"
                      Items="_shoppingList.Items.OrderBy(i => i.Order).ToList()"
                      ItemsSelector="@((item, zone) => true)"
                      ItemDropped="OnItemDropped"
                      Class="mud-width-full">
        <ChildContent>
            <MudDropZone T="ShoppingListItem"
                         Identifier="shopping-list"
                         AllowReorder="true"
                         Class="mud-width-full" />
        </ChildContent>
        <ItemRenderer>
            <MudPaper Elevation="1" Class="pa-2 ma-1">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.DragHandle"
                             Color="Color.Default"
                             Class="mr-2"
                             Style="cursor: grab;" />
                    <MudCheckBox @bind-Value="context.IsChecked"
                                 Color="Color.Primary"
                                 @bind-Value:after="@(async () => await ShoppingListService.UpdateItemCheckedAsync(context.Id, context.IsChecked))" />
                    <MudText Style="@(context.IsChecked ? "text-decoration: line-through; opacity: 0.5;" : string.Empty)">
                        @FormatItem(context)
                    </MudText>
                </MudStack>
            </MudPaper>
        </ItemRenderer>
    </MudDropContainer>

    <MudStack Row="true" Class="mt-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="Regenerate">
            Regenerate
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Undo"
                   OnClick="UncheckAll">
            Uncheck All
        </MudButton>
    </MudStack>
}

@code {
    private ShoppingList? _shoppingList;
    private bool _loading = true;
    private bool _noActivePlan = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadShoppingList();
    }

    private async Task LoadShoppingList()
    {
        _loading = true;
        _shoppingList = await ShoppingListService.GetShoppingListForActivePlanAsync();

        if (_shoppingList is null)
        {
            _shoppingList = await ShoppingListService.GenerateOrMergeShoppingListAsync();
        }

        _noActivePlan = _shoppingList is null || !_shoppingList.Items.Any();
        _loading = false;
    }

    private async Task Regenerate()
    {
        _loading = true;
        _shoppingList = await ShoppingListService.GenerateOrMergeShoppingListAsync();
        _noActivePlan = _shoppingList is null || !_shoppingList.Items.Any();
        _loading = false;
    }

    private async Task OnItemDropped(MudItemDropInfo<ShoppingListItem> dropInfo)
    {
        if (dropInfo.Item is null || _shoppingList is null)
        {
            return;
        }

        List<ShoppingListItem> ordered = _shoppingList.Items.OrderBy(i => i.Order).ToList();
        int oldIndex = ordered.IndexOf(dropInfo.Item);
        int newIndex = dropInfo.IndexInZone;

        if (oldIndex == newIndex)
        {
            return;
        }

        ordered.RemoveAt(oldIndex);
        ordered.Insert(newIndex, dropInfo.Item);

        for (int i = 0; i < ordered.Count; i++)
        {
            ordered[i].Order = i;
        }

        await ShoppingListService.ReorderItemsAsync(ordered);
    }

    private async Task OnCheckedChanged(ShoppingListItem item, bool value)
    {
        item.IsChecked = value;
        await ShoppingListService.UpdateItemCheckedAsync(item.Id, value);
        StateHasChanged();
    }

    private async Task UncheckAll()
    {
        if (_shoppingList is null)
        {
            return;
        }

        foreach (ShoppingListItem item in _shoppingList.Items)
        {
            await ShoppingListService.UpdateItemCheckedAsync(item.Id, false);
        }

        _shoppingList = await ShoppingListService.GetShoppingListForActivePlanAsync();

        StateHasChanged();
    }

    private string FormatItem(ShoppingListItem item)
    {
        string quantity = item.Quantity.HasValue ? item.Quantity.Value.ToString("G29") : string.Empty;
        string unit = item.Unit != UnitMeasurement.None ? item.Unit.ToString() : string.Empty;
        return $"{item.Name} {quantity} {unit}".Trim();
    }
}