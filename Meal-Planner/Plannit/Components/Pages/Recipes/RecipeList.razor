@page "/recipes"
@inject RecipeService RecipeService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="mb-4">Recipes</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_recipes.Count == 0)
{
    <MudText>No recipes found. Add one to get started!</MudText>
}
else
{
    <MudGrid>
        @foreach (Recipe recipe in _recipes)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@recipe.Name</MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">@recipe.Description</MudText>
                        <MudText Typo="Typo.caption" Class="mt-2">
                            @(recipe.Servings.HasValue ? $"Serves {recipe.Servings}" : "Servings not specified")
                        </MudText>
                        <MudText Typo="Typo.caption">
                            @($"{recipe.Ingredients.Count} ingredient{(recipe.Ingredients.Count == 1 ? "" : "s")}")
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick="@(() => ViewRecipe(recipe.Id))">
                            View
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   OnClick="@(() => EditRecipe(recipe.Id))">
                            Edit
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   OnClick="@(async () => await DeleteRecipe(recipe.Id))">
                            Delete
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add"
           OnClick="@(() => NavigationManager.NavigateTo("/recipes/add"))"
           Class="mt-4">
    Add Recipe
</MudButton>

@code {
    private List<Recipe> _recipes = new List<Recipe>();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _recipes = await RecipeService.GetAllRecipesAsync();
        _loading = false;
    }

    private void ViewRecipe(Guid id)
    {
        NavigationManager.NavigateTo($"/recipes/{id}");
    }

    private void EditRecipe(Guid id)
    {
        NavigationManager.NavigateTo($"/recipes/{id}/edit");
    }

    private async Task DeleteRecipe(Guid id)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Recipe",
            "Are you sure you want to delete this recipe? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });

        if (confirmed == true)
        {
            await RecipeService.DeleteRecipeAsync(id);
            _recipes = await RecipeService.GetAllRecipesAsync();
        }
    }
}