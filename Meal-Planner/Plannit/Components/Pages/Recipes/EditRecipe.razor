@page "/recipes/{Id:guid}/edit"
@inject RecipeService RecipeService
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" Class="mb-4">Edit Recipe</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_recipe is null)
{
    <MudText>Recipe not found.</MudText>
}
else
{
    <EditForm Model="_recipe" OnValidSubmit="HandleValidSubmit" FormName="EditRecipeForm">
        <DataAnnotationsValidator />

        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-2">Basic Details</MudText>

                <MudTextField @bind-Value="_recipe.Name"
                              Label="Recipe Name"
                              For="@(() => _recipe.Name)"
                              Required="true"
                              Variant="Variant.Outlined"
                              Class="mb-3" />

                <MudTextField @bind-Value="_recipe.Description"
                              Label="Description"
                              For="@(() => _recipe.Description)"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Class="mb-3" />

                <MudNumericField T="int?"
                                 @bind-Value="_recipe.Servings"
                                 Label="Servings"
                                 For="@(() => _recipe.Servings)"
                                 Min="1"
                                 Variant="Variant.Outlined"
                                 Class="mb-3" />
            </MudCardContent>
        </MudCard>

        <MudCard Class="mt-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-2">Ingredients</MudText>

                @foreach (Ingredient ingredient in _recipe.Ingredients)
                {
                    <MudGrid Class="mb-2">
                        <MudItem xs="4">
                            <MudTextField @bind-Value="ingredient.Name"
                                          Label="Ingredient"
                                          Required="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="ingredient.Quantity"
                                             Label="Quantity"
                                             Min="0.01m"
                                             Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudSelect @bind-Value="ingredient.Unit"
                                       Label="Unit"
                                       Variant="Variant.Outlined">
                                @foreach (UnitMeasurement unit in Enum.GetValues<UnitMeasurement>())
                                {
                                    <MudSelectItem Value="unit">@unit.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="2" Class="d-flex align-center">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           OnClick="@(() => RecipeService.RemoveIngredient(_recipe, ingredient))" />
                        </MudItem>
                    </MudGrid>
                }

                <MudButton StartIcon="@Icons.Material.Filled.Add"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           OnClick="@(() => RecipeService.AddIngredient(_recipe))"
                           Class="mt-2">
                    Add Ingredient
                </MudButton>
            </MudCardContent>
        </MudCard>

        <MudCard Class="mt-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-2">Method</MudText>

                @foreach (MethodStep step in _recipe.MethodSteps)
                {
                    <MudGrid Class="mb-2">
                        <MudItem xs="1" Class="d-flex align-center">
                            <MudText Typo="Typo.h6">@step.StepNumber</MudText>
                        </MudItem>
                        <MudItem xs="9">
                            <MudTextField @bind-Value="step.Instruction"
                                          Label="@($"Step {step.StepNumber}")"
                                          Required="true"
                                          Lines="2"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="2" Class="d-flex align-center">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           OnClick="@(() => RecipeService.RemoveStep(_recipe, step))" />
                        </MudItem>
                    </MudGrid>
                }

                <MudButton StartIcon="@Icons.Material.Filled.Add"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           OnClick="@(() => RecipeService.AddStep(_recipe))"
                           Class="mt-2">
                    Add Step
                </MudButton>
            </MudCardContent>
        </MudCard>

        <MudStack Row="true" Class="mt-4">
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Save Changes
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       OnClick="@(() => NavigationManager.NavigateTo($"/recipes/{Id}"))">
                Cancel
            </MudButton>
        </MudStack>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Recipe? _recipe;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _recipe = await RecipeService.GetRecipeByIdAsync(Id);
        _loading = false;
    }

    private async Task HandleValidSubmit()
    {
        await RecipeService.UpdateRecipeAsync(_recipe!);
        NavigationManager.NavigateTo($"/recipes/{Id}");
    }
}