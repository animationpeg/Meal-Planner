@inject NavigationManager NavigationManager

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Home
    </MudNavLink>

    <MudNavGroup Title="Recipes" Icon="@Icons.Material.Filled.MenuBook" Expanded="true">
        <MudNavLink Href="/recipes" Icon="@Icons.Material.Filled.List">
            All Recipes
        </MudNavLink>
        <MudNavLink Href="/recipes/add" Icon="@Icons.Material.Filled.Add">
